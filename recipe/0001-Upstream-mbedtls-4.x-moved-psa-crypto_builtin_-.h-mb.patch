---
 src/PE/signature/Signature.cpp | 2 +-
 src/PE/utils.cpp               | 2 +-
 src/visitors/hash.cpp          | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/src/PE/signature/Signature.cpp b/src/PE/signature/Signature.cpp
index 2d2c589..f6ccb78 100644
--- a/src/PE/signature/Signature.cpp
+++ b/src/PE/signature/Signature.cpp
@@ -29,7 +29,7 @@
 #include "LIEF/PE/signature/SpcIndirectData.hpp"
 #include "LIEF/PE/signature/RsaInfo.hpp"
 
-#include <psa/crypto_builtin_primitives.h>
+#include "mbedtls/private/crypto_builtin_primitives.h"
 
 #include "frozen.hpp"
 #include "internal_utils.hpp"
diff --git a/src/PE/utils.cpp b/src/PE/utils.cpp
index 0c44521..7a41971 100644
--- a/src/PE/utils.cpp
+++ b/src/PE/utils.cpp
@@ -21,7 +21,7 @@
 #endif
 
 #include "logging.hpp"
-#include "psa/crypto_builtin_primitives.h"
+#include "mbedtls/private/crypto_builtin_primitives.h"
 
 #include "LIEF/PE/utils.hpp"
 #include "LIEF/PE/Binary.hpp"
diff --git a/src/visitors/hash.cpp b/src/visitors/hash.cpp
index 29df1e0..05c93ae 100644
--- a/src/visitors/hash.cpp
+++ b/src/visitors/hash.cpp
@@ -17,7 +17,7 @@
 #include <numeric>
 
 #include "mbedtls_wraps.h"
-#include "psa/crypto_builtin_primitives.h"
+#include "mbedtls/private/crypto_builtin_primitives.h"
 
 #include "LIEF/hash.hpp"
 
